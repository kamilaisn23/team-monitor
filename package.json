{
    "name": "team-monitor",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "npm run build:worker && npm run build:frontend && next build",
        "build:worker": "node scripts/build-worker.mjs",
        "build:frontend": "vite build --config frontend/vite.config.ts",
        "start": "node scripts/start.mjs",
        "sync": "ts-node --project tsconfig.server.json scripts/sync-cron.ts",
        "docker:prepare": "node scripts/docker.mjs prepare",
        "docker:up": "node scripts/docker.mjs up",
        "docker:down": "node scripts/docker.mjs down",
        "docker:status": "node scripts/docker.mjs status",
        "typecheck": "vue-tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit",
        "test": "node scripts/github-smoke.mjs && node scripts/preview-smoke.mjs && node scripts/dashboard-smoke.mjs && node scripts/attention-smoke.mjs && node scripts/sync-access-smoke.mjs && node scripts/csv-smoke.mjs && node scripts/read-access-smoke.mjs && node scripts/member-issues-smoke.mjs && node scripts/vue-smoke.mjs",
        "postinstall": "prisma generate"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.7.4",
        "@lucide/vue": "^1.55.0",
        "@prisma/client": "^5.22.0",
        "dayjs": "^1.11.13",
        "dotenv": "^16.6.1",
        "next": "^16.1.6",
        "next-auth": "^5.0.0-beta.25",
        "node-cron": "^3.0.3",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "vue": "^3.5.43",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@types/node": "^22",
        "@types/node-cron": "^3.0.11",
        "@types/react": "19.0.8",
        "@types/react-dom": "19.0.3",
        "@vitejs/plugin-vue": "^6.0.10",
        "esbuild": "^0.28.2",
        "jsdom": "^26.1.0",
        "postcss": "^8",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5",
        "vite": "^8.3.4",
        "vue-tsc": "^3.3.13"
    }
}

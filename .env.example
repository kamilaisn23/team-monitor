# App
# Generate with: openssl rand -base64 32 — NEVER deploy the placeholder
AUTH_SECRET=generate-a-random-secret-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# GitHub OAuth (login SSO)
AUTH_GITHUB_ID=your-github-client-id
AUTH_GITHUB_SECRET=your-github-client-secret

# Superadmin
SUPERADMIN_GITHUB_USERNAME=your-github-username

# GitHub org (issue sync)
# For a personal account, set GITHUB_USER_NAME and leave GITHUB_ORG_NAME empty.
# GITHUB_TOKEN is optional for public repos; private repos require an authorized token.
GITHUB_USER_NAME=
GITHUB_TOKEN=
# GITHUB_ORG_TOKEN remains supported for existing organization deployments.
GITHUB_ORG_TOKEN=your-github-org-token
GITHUB_ORG_NAME=your-org-name

# GitLab group (issue sync)
GITLAB_GROUP_TOKEN=your-gitlab-group-token
GITLAB_GROUP_ID=your-gitlab-group-id
GITLAB_BASE_URL=https://gitlab.yourcompany.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/team_monitor
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# External API service tokens (comma-separated, supports rotation)
# Used by /api/external/* routes to authenticate service-to-service calls
KERJABAIK_SERVICE_TOKENS=token-active,token-prev

# Kerjabaik base URL and outbound service token (for employee sync + backfill)
KERJABAIK_BASE_URL=https://kerjabaik.yourcompany.com
KERJABAIK_SERVICE_TOKEN=your-outbound-service-token
